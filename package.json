{
  "name": "@mortar_zh/any-diff",
  "version": "0.1.0",
  "description": "Framework-agnostic HTML diff library with structured markers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "html-diff",
    "rich-text",
    "diff",
    "comparison"
  ],
  "author": "mortar_zh",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fast-check": "^4.10.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "parse5": "^7.1.2"
  }
}
